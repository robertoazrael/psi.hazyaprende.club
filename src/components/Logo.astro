---
import logoDark from '../assets/branding/logo/mente-aumentada-logo-dark.svg';
import logoLight from '../assets/branding/logo/mente-aumentada-logo-light.svg';

export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<span class={`inline-flex items-center ${className}`}>
  <img
    src={logoDark.src}
    alt="Mente Aumentada"
    class="theme-image-light h-11 w-auto"
    width="222"
    height="54"
  />
  <img
    src={logoLight.src}
    alt="Mente Aumentada"
    class="theme-image-dark h-11 w-auto"
    width="222"
    height="54"
  />
</span>
