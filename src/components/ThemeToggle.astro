<button
  type="button"
  class="inline-flex h-11 w-11 items-center justify-center rounded-full border"
  data-theme-toggle
  aria-label="Cambiar entre modo claro y oscuro"
  aria-pressed="false"
  title="Cambiar tema"
>
  <span class="theme-image-light text-lg" aria-hidden="true">☼</span>
  <span class="theme-image-dark text-lg" aria-hidden="true">◐</span>
</button>

<script is:inline>
  (() => {
    const storageKey = 'mente-aumentada-theme';
    const root = document.documentElement;

    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      root.classList.toggle('dark', theme === 'dark');
      root.style.colorScheme = theme;

      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const isDark = theme === 'dark';
        button.setAttribute('aria-pressed', String(isDark));
        button.setAttribute('title', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
        button.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
      });
    };

    const initialize = () => {
      const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
      applyTheme(current);

      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        if (button.dataset.boundThemeToggle === 'true') return;
        button.dataset.boundThemeToggle = 'true';
        button.addEventListener('click', () => {
          const active = root.dataset.theme === 'dark' ? 'dark' : 'light';
          const next = active === 'dark' ? 'light' : 'dark';
          localStorage.setItem(storageKey, next);
          applyTheme(next);
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }
  })();
</script>
