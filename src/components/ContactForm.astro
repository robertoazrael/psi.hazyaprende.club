---
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
---

<div class="surface-card p-6 sm:p-8">
  <form data-form="contacto-general" data-endpoint={endpoint} class="space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Nombre</span>
        <input class="field" name="nombre" type="text" autocomplete="name" required />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Email</span>
        <input class="field" name="email" type="email" autocomplete="email" required />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Organización</span>
        <input class="field" name="organizacion" type="text" autocomplete="organization" />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Motivo de contacto</span>
        <input class="field" name="motivo" type="text" />
      </label>

      <label class="block sm:col-span-2">
        <span class="mb-2 block text-sm font-medium">Mensaje</span>
        <textarea class="field min-h-36" name="mensaje" required></textarea>
      </label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <button type="submit" class="btn-primary">Enviar mensaje</button>
      <p data-status class="text-sm" aria-live="polite" style="color: var(--text-soft);"></p>
    </div>
  </form>
</div>

<script is:inline>
  const forms = document.querySelectorAll('[data-form="contacto-general"]');

  const setStatus = (node, message, isError = false) => {
    node.textContent = message;
    node.style.color = isError ? '#b04b4b' : 'var(--text-soft)';
  };

  forms.forEach((form) => {
    const status = form.querySelector('[data-status]');
    const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        setStatus(status, 'No hay un endpoint configurado para este formulario.', true);
        return;
      }

      submitButton.disabled = true;
      setStatus(status, 'Enviando...');

      const formData = new FormData(form);
      const payload = {
        source: 'contacto_general',
        nombre: formData.get('nombre'),
        email: formData.get('email'),
        organizacion: formData.get('organizacion'),
        motivo: formData.get('motivo'),
        mensaje: formData.get('mensaje')
      };

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          throw new Error('request_failed');
        }

        form.reset();
        submitButton.disabled = false;
        setStatus(status, 'Mensaje enviado correctamente.');
      } catch {
        submitButton.disabled = false;
        setStatus(status, 'No se pudo enviar el mensaje. Intenta de nuevo en unos momentos.', true);
      }
    });
  });
</script>
