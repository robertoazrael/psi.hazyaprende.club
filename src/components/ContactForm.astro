---
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
---

<div class="surface-card p-6 sm:p-8">
  <form data-form="contacto-general" data-endpoint={endpoint} class="space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Nombre</span>
        <input class="field" name="nombre" type="text" autocomplete="name" required />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Email</span>
        <input class="field" name="email" type="email" autocomplete="email" required />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Organización</span>
        <input class="field" name="organizacion" type="text" autocomplete="organization" />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Motivo de contacto</span>
        <input class="field" name="motivo" type="text" />
      </label>

      <label class="block sm:col-span-2">
        <span class="mb-2 block text-sm font-medium">Mensaje</span>
        <textarea class="field min-h-36" name="mensaje"></textarea>
      </label>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <button type="submit" class="btn-primary">Enviar mensaje</button>
      <p data-status class="text-sm" aria-live="polite" style="color: var(--text-soft);"></p>
    </div>
  </form>
</div>

<script>
  import { setupWebhookForm } from '../scripts/webhook-form';

  setupWebhookForm({
    selector: '[data-form="contacto-general"]',
    loadingMessage: 'Enviando tu mensaje...',
    successMessage: 'Gracias. Tu mensaje fue enviado correctamente.',
    errorMessage: 'No pudimos enviar tu mensaje. Inténtalo de nuevo en unos momentos.',
    getPayload: (formData, interactionDelay) => ({
      source: 'mente_aumentada_contacto',
      nombre: String(formData.get('nombre') ?? ''),
      email: String(formData.get('email') ?? ''),
      organizacion: String(formData.get('organizacion') ?? ''),
      motivo: String(formData.get('motivo') ?? ''),
      mensaje: String(formData.get('mensaje') ?? ''),
      interaction_delay: interactionDelay
    }),
    onSuccess: ({ form }) => {
      const submitButton = form.querySelector('button[type="submit"]');

      form.reset();
      form.removeAttribute('aria-busy');

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
        submitButton.textContent = 'Enviar mensaje';
      }
    }
  });
</script>
